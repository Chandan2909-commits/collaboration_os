# ==============================================================================
# CrossTech Collaboration OS - Environment Configuration
# ==============================================================================

# Clerk Authentication Keys
# Get these from your Clerk dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Supabase Database & Realtime
# Get these from your Supabase project settings -> API: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Configuration
NEXT_PUBLIC_APP_NAME="CrossTech Collaboration OS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
